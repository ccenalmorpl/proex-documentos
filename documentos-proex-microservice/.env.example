# AWS Lambda Configuration
AWS_REGION=eu-south-2
LAMBDA_FUNCTION_NAME=proex-documents
ECR_REPO_NAME=proex-documents
FUNCTION_NAME=proex-documents
AWS_ACCOUNT_ID=AWS_ACCOUNT_ID

# HubSpot
HUBSPOT_ACCESS_TOKEN=HUBSPOT_ACCESS_TOKEN
PROEX_ACCESS_TOKEN=PROEX_ACCESS_TOKEN
HUBSPOT_WEBHOOK_SECRET=HUBSPOT_WEBHOOK_SECRET

# Card auth - secreto compartido con la card de HubSpot para los endpoints
# de negocio (/api/v1/documentos, /api/v1/empresas, /api/v1/pedidos).
# Viaja en el header Authorization como "Bearer <secreto>": hubspot.fetch()
# descarta cualquier otro header custom, así que es el único mecanismo
# posible para autenticar la llamada desde la card. Solo se exige si
# DEBUG=False; si falta en producción, esos endpoints responden 503.
PROEX_CARD_SECRET=PROEX_CARD_SECRET

# CORS
CORS_ORIGINS=http://localhost:3000,https://app.hubspot.com,https://app-eu1.hubspot.com

# App Configuration
DEBUG=True
APP_NAME="Documentos Proex Microservice"
VERSION=1.0.0

# Server Configuration (for local development)
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO

# Sanitario - valor fijo que se imprime en el certificado
SANITARIO_EMPRESA_DIRECCION="PROEX S.L. - Calle Ejemplo 1, 28001 Madrid, España"

# HubSpot File Manager - carpeta destino para PDFs generados
FILES_FOLDER=/documentos-proex

# (Opcional) Ruta local a plantillas si no están embebidas en el código
# TEMPLATES_PATH=./app/documentos/templates
